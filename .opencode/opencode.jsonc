{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "experimental": {
    "orchestration": {
      "global_scheduler": {
        "enabled": true,
        "profile": "balanced_pro"
      }
    }
  },
  "mcp": {
    "websearch-stacked": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\HP\\.codex\\mcp-servers\\searxng-mcp\\index.js"
      ],
      "environment": {
        "TAVILY_API_KEY": "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",
        "EXA_API_KEY": "82a13fd4-d33e-48fa-8fa5-ccf5b77c3ed4",
        "SEARXNG_URL": "http://127.0.0.1:8889"
      },
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
